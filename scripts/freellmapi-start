#!/data/data/com.termux/files/usr/bin/bash
# Start FreeLLMAPI provider gateway (monorepo — npm workspaces)
# Server API: http://localhost:3001
# Dashboard:  http://localhost:5173
# Repo:       ~/freellmapi (github.com/tashfeenahmed/freellmapi)

REPO="$HOME/freellmapi"
LOGFILE="$HOME/.local/share/freellmapi/server.log"
FLLM_KEY="${FREELLMAPI_KEY:-freellmapi-71ad8153feaf0accfde99e05d2e22fc792e59be02673ffdd}"

if [ ! -d "$REPO/node_modules" ]; then
  echo "✗ FreeLLMAPI not installed — run: cd ~/freellmapi && npm install"
  exit 1
fi

if curl -s --max-time 1 -H "Authorization: Bearer $FLLM_KEY" http://127.0.0.1:3001/v1/models &>/dev/null 2>&1; then
  echo "FreeLLMAPI already running at http://localhost:3001"
  exit 0
fi

echo "Starting FreeLLMAPI..."
mkdir -p "$HOME/.local/share/freellmapi"

# 1. Sync OpenRouter's free models into the FreeLLMAPI catalog.
#    Non-fatal: a dead network or a rotated key logs one line and the gateway
#    still starts on the last-known-good catalog. Rate-limited to 12h.
echo "  ► Syncing OpenRouter free models..."
python3 "$HOME/AI_SYSTEM/scripts/sync_openrouter_free_models.py" || true

# Start server (workspace)
cd "$REPO"
nohup npm run dev -w server >> "$LOGFILE" 2>&1 &
SERVER_PID=$!
disown $SERVER_PID
echo "Server PID: $SERVER_PID"

# Start client dashboard (workspace)
nohup npm run dev -w client >> "$HOME/.local/share/freellmapi/client.log" 2>&1 &
CLIENT_PID=$!
disown $CLIENT_PID
echo "Client PID: $CLIENT_PID"

sleep 5
if curl -s --max-time 2 -H "Authorization: Bearer $FLLM_KEY" http://127.0.0.1:3001/v1/models &>/dev/null 2>&1; then
  echo "✓ FreeLLMAPI API   — http://localhost:3001"
  echo "✓ Dashboard        — http://localhost:5173"
else
  echo "Waiting a bit more..."
  sleep 5
  if curl -s --max-time 2 -H "Authorization: Bearer $FLLM_KEY" http://127.0.0.1:3001/v1/models &>/dev/null 2>&1; then
    echo "✓ FreeLLMAPI running"
  else
    echo "✗ Failed to start — check $LOGFILE"
    echo "  Manual start: cd ~/freellmapi && npm run dev"
  fi
fi
