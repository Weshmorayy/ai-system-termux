#!/data/data/com.termux/files/usr/bin/bash
# Start FreeLLMAPI dashboard client only (Vite dev server)
# Dashboard: http://localhost:5173
REPO="$HOME/freellmapi"
LOG="$HOME/.local/share/freellmapi/client.log"
mkdir -p "$HOME/.local/share/freellmapi"
cd "$REPO"
nohup npm run dev -w client > "$LOG" 2>&1 &
echo "Dashboard starting at http://localhost:5173 (PID: $!)"
sleep 3
termux-open-url "http://localhost:5173" 2>/dev/null || echo "Open in browser: http://localhost:5173"
